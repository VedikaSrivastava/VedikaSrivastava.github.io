# Secrets are managed in Doppler only — no .env files needed.
# Project: vedikasrivastava-github-io
#
#   dev_personal -> local (`npm run dev`)
#   prd          -> production (CI uses DOPPLER_TOKEN + `doppler run` — no per-var listing)
#
# Required in both dev_personal and prd:
#   VITE_CLARITY_PROJECT_ID=<your-clarity-project-id>
